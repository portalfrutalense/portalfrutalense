# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envio de e-mails / Magic Links)
RESEND_API_KEY=
# Gerado em resend.com/webhooks — obrigatório: sem isso o endpoint
# /api/webhooks/resend recusa toda chamada (ver route.ts).
RESEND_WEBHOOK_SECRET=

# Cloudflare Turnstile (Captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL base do site (sem barra no final) — usada apenas em API routes (server-side)
SITE_URL=http://localhost:3000

# Chave compartilhada entre rotas internas do servidor (ex: /api/demandas
# chamando /api/ia/analisar). Nunca é enviada ao navegador.
INTERNAL_SECRET=

# Google Gemini — moderação de conteúdo por IA e chatbot conversacional
GEMINI_API_KEY=

# Esri ArcGIS — satélite + nomes de rua do mapa principal (/mapa). Sem essa
# chave o mapa principal fica sem imagem de satélite nenhuma.
NEXT_PUBLIC_ARCGIS_API_KEY=

# Mapbox — geocodificação de endereço, miniatura de satélite no fluxo do
# WhatsApp, E o mini-mapa de confirmar endereço (usado ao registrar Demanda,
# Pet, Classificado, Emprego e no assistente de IA) — só o mapa PRINCIPAL
# (/mapa) usa Esri; esse mini-mapa continua em Mapbox por decisão do projeto.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Evolution API (self-hosted) — gateway de WhatsApp
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo compartilhado que só você e a Evolution API conhecem — configure a
# URL do webhook na Evolution API como ".../api/whatsapp/webhook?secret=ESTE_VALOR"
WHATSAPP_WEBHOOK_SECRET=
